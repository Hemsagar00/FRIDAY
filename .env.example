# FRIDAY Environment Configuration
# Copy this file to .env and fill in your keys.
# .env is in .gitignore — never commit real keys!

# --- AI Model Providers ---
# OpenAI (GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude 3.5 Sonnet, etc.)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google (Gemini, etc.)
GOOGLE_API_KEY=your-google-key

# xAI (Grok)
XAI_API_KEY=xai-your-key

# --- Local / Self-Hosted ---
# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# LM Studio (local API server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Cloud Providers (Ollama Cloud, etc.) ---
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key

# --- Search / Web ---
# Serper / Google Programmable Search
SERPER_API_KEY=your-serper-key
GOOGLE_SEARCH_API_KEY=your-google-search-key
GOOGLE_SEARCH_CX=your-search-engine-id

# Brave Search
BRAVE_API_KEY=your-brave-key

# --- Communication ---
# Telegram Bot (for gateway mode)
TELEGRAM_BOT_TOKEN=123456789:ABC-your-telegram-token

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-token

# --- Storage / Sync ---
# Notion
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your-database-id

# Google (Gmail, Drive, Calendar)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# --- Development ---
# Cloudflare (tunnel, workers)
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Vercel (deployments)
VERCEL_TOKEN=your-vercel-token

# GitHub (fine-grained personal access token)
GITHUB_TOKEN=ghp_your_token

# --- Database ---
# ChromaDB (if using remote)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Pinecone (vector DB)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=your-index-name

# --- Voice (Optional) ---
# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your-elevenlabs-key

# Deepgram (STT)
DEEPGRAM_API_KEY=your-deepgram-key

# --- Monitoring ---
# LangSmith (tracing)
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=friday-dev

# Weights & Biases (ML experiments)
WANDB_API_KEY=your-wandb-key
